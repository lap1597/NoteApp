<%- include("content/header.ejs") %>

<h1>Notes App</h1>
<form id="noteForm" action="/create_event" method="post">
    <div>
        <textarea id="noteInput" name="description" placeholder="Write your note here..." required></textarea>
        <br>
        
        <label for="publishToCalendar">Publish to Google Calendar</label>
        <input type="checkbox" id="publishToCalendar" name="publishToCalendar" value="true">
      
    </div>
    <div id="calendarInputs" style="display: none;">
        <label for="summary">Event Title:</label>
        <input type="text" name="summary" id="summary" class="feedback-input"><br>

        <div id="dateInputs">
            <label for="start">Start Date:</label>
            <input type="date" id="start" name="start" class="feedback-input" ><br>

            <label for="end">End Date:</label>
            <input type="date" id="end" name="end" class="feedback-input"><br>
        </div>

        <div id="timeInputs">
            <label for="startTime">Start Time:</label>
            <input type="time" id="startTime" name="startTime" class="feedback-input"><br>

            <label for="endTime">End Time:</label>
            <input type="time" id="endTime" name="endTime" class="feedback-input"><br>
        </div>

        <label for="category">Category:</label>
        <select id="category" name="category" class="feedback-input" >
            <option value="class">Class</option>
            <option value="study">Study Session</option>
            <option value="meeting">Meeting</option>
            <option value="project">Project Work</option>
            <option value="break">Break</option>
            <option value="personal">Personal Task</option>
        </select><br>
        <div>
        
            <label for="useAiSuggestion">Use AI to Suggest Time:</label>
            <input type="checkbox" id="useAiSuggestion" name="useAiSuggestion" value="true"><br>
            
        </div>
    </div>
    <div>
   
        <button type="submit">Add Note</button>
    </div>

</form>


<script>
    document.getElementById('publishToCalendar').addEventListener('change', function () {
        const calendarInputs = document.getElementById('calendarInputs');
        const isPublishChecked = this.checked;
    
        // Show or hide calendar input fields
        calendarInputs.style.display = isPublishChecked ? 'block' : 'none';
    
        // Dynamically manage input states
        document.querySelectorAll('#calendarInputs .feedback-input').forEach(function (input) {
            if (isPublishChecked) {
                input.removeAttribute('disabled'); // Enable input
                input.setAttribute('required', 'required'); // Add required validation
            } else {
                input.setAttribute('disabled', 'disabled'); // Disable input
                input.removeAttribute('required'); // Remove required validation
                input.value = ''; // Clear the value
            }
        });
    });
    document.getElementById('useAiSuggestion').addEventListener('change', function() {
        console.log('useAiSuggestion changed');
        var timeInputs = document.getElementById('timeInputs');
        var startTime = document.getElementById('startTime');
        var endTime = document.getElementById('endTime');

        if (this.checked) {
            timeInputs.style.display = 'none';
            // Remove required attributes when AI suggestion is used
            startTime.removeAttribute('required');
            endTime.removeAttribute('required');
        } else {
            timeInputs.style.display = 'block';
            // Add required attributes back when AI suggestion is not used
            startTime.setAttribute('required', 'required');
            endTime.setAttribute('required', 'required');
        }
    });

    // Ensure proper behavior on form submission
    document.getElementById('noteForm').addEventListener('submit', function (event) {
        const isPublishChecked = document.getElementById('publishToCalendar').checked;
    
        if (!isPublishChecked) {
            // Disable all inputs inside calendarInputs
            document.querySelectorAll('#calendarInputs .feedback-input').forEach(function (input) {
                input.setAttribute('disabled', 'disabled');
                input.removeAttribute('required'); // Ensure no validation on hidden inputs
            });
        }
    });
</script>





<%- include("content/footer.ejs") %>
